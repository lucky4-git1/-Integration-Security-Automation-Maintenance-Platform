generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================================
// IDENTITY & ACCESS MANAGEMENT
// ============================================================================

model Organization {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique
  settings  Json     @default("{}")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  members              OrganizationMember[]
  integrations         Integration[]
  automations          Automation[]
  incidents            Incident[]
  backupPolicies       BackupPolicy[]
  securityFindings     SecurityFinding[]
  documents            Document[]
  performanceReviews   PerformanceReview[]
  auditLogs            AuditLog[]
  apiKeys              ApiKey[]
  notificationChannels NotificationChannel[]

  @@index([slug])
  @@map("organizations")
}

model User {
  id                String    @id @default(uuid())
  email             String    @unique
  passwordHash      String
  firstName         String
  lastName          String
  emailVerified     Boolean   @default(false)
  emailVerifiedAt   DateTime?
  mfaEnabled        Boolean   @default(false)
  mfaSecret         String?
  lastLoginAt       DateTime?
  lastLoginIp       String?
  passwordChangedAt DateTime  @default(now())
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  // Relations
  organizations  OrganizationMember[]
  sessions       Session[]
  passwordResets PasswordReset[]
  auditLogs      AuditLog[]

  @@index([email])
  @@map("users")
}

model OrganizationMember {
  id             String   @id @default(uuid())
  organizationId String
  userId         String
  roleId         String
  invitedBy      String?
  joinedAt       DateTime @default(now())
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // Relations
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  role         Role         @relation(fields: [roleId], references: [id])

  @@unique([organizationId, userId])
  @@index([organizationId])
  @@index([userId])
  @@index([roleId])
  @@map("organization_members")
}

model Role {
  id          String   @id @default(uuid())
  name        String
  slug        String   @unique
  description String?
  permissions Json     @default("[]")
  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  members OrganizationMember[]

  @@index([slug])
  @@map("roles")
}

model Session {
  id           String    @id @default(uuid())
  userId       String
  token        String    @unique
  refreshToken String?   @unique
  ipAddress    String?
  userAgent    String?
  expiresAt    DateTime
  revokedAt    DateTime?
  createdAt    DateTime  @default(now())

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@index([expiresAt])
  @@map("sessions")
}

model PasswordReset {
  id        String    @id @default(uuid())
  userId    String
  token     String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@map("password_resets")
}

model ApiKey {
  id             String    @id @default(uuid())
  organizationId String
  name           String
  keyHash        String    @unique
  prefix         String
  scopes         Json      @default("[]")
  expiresAt      DateTime?
  lastUsedAt     DateTime?
  revokedAt      DateTime?
  createdBy      String
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  // Relations
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([keyHash])
  @@map("api_keys")
}

// ============================================================================
// INTEGRATIONS
// ============================================================================

model Integration {
  id              String    @id @default(uuid())
  organizationId  String
  name            String
  provider        String
  config          Json      @default("{}")
  credentials     String // Encrypted JSON
  status          String    @default("pending") // pending, active, error, disconnected
  lastSyncAt      DateTime?
  lastErrorAt     DateTime?
  lastErrorMessage String?
  metadata        Json      @default("{}")
  createdBy       String
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  // Relations
  organization     Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  executions       AutomationExecution[]
  webhookDeliveries WebhookDelivery[]

  @@index([organizationId])
  @@index([provider])
  @@index([status])
  @@map("integrations")
}

model WebhookDelivery {
  id            String    @id @default(uuid())
  integrationId String
  eventType     String
  payload       Json
  signature     String?
  status        String    @default("pending") // pending, processing, success, failed
  attempts      Int       @default(0)
  processedAt   DateTime?
  errorMessage  String?
  createdAt     DateTime  @default(now())

  // Relations
  integration Integration @relation(fields: [integrationId], references: [id], onDelete: Cascade)

  @@index([integrationId])
  @@index([status])
  @@index([createdAt])
  @@map("webhook_deliveries")
}

// ============================================================================
// AUTOMATION & EXECUTION
// ============================================================================

model Automation {
  id             String   @id @default(uuid())
  organizationId String
  name           String
  description    String?
  type           String // scheduled, webhook, manual, api
  schedule       String? // Cron expression
  timezone       String   @default("UTC")
  config         Json     @default("{}")
  enabled        Boolean  @default(true)
  concurrency    Int      @default(1)
  timeout        Int      @default(300000) // milliseconds
  retryPolicy    Json     @default("{}")
  createdBy      String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // Relations
  organization Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  executions   AutomationExecution[]

  @@index([organizationId])
  @@index([type])
  @@index([enabled])
  @@map("automations")
}

model AutomationExecution {
  id            String    @id @default(uuid())
  automationId  String
  organizationId String
  integrationId String?
  status        String    @default("queued") // queued, running, succeeded, failed, timeout, cancelled
  trigger       String // scheduled, webhook, manual, api
  startedAt     DateTime?
  completedAt   DateTime?
  duration      Int? // milliseconds
  attempt       Int       @default(1)
  maxAttempts   Int       @default(3)
  input         Json?
  output        Json?
  error         String?
  metadata      Json      @default("{}")
  traceId       String?
  createdBy     String?
  createdAt     DateTime  @default(now())

  // Relations
  automation  Automation   @relation(fields: [automationId], references: [id], onDelete: Cascade)
  integration Integration? @relation(fields: [integrationId], references: [id], onDelete: SetNull)
  logs        ExecutionLog[]

  @@index([automationId])
  @@index([organizationId])
  @@index([status])
  @@index([createdAt])
  @@index([traceId])
  @@map("automation_executions")
}

model ExecutionLog {
  id          String   @id @default(uuid())
  executionId String
  level       String // debug, info, warn, error
  message     String
  metadata    Json     @default("{}")
  timestamp   DateTime @default(now())

  // Relations
  execution AutomationExecution @relation(fields: [executionId], references: [id], onDelete: Cascade)

  @@index([executionId])
  @@index([level])
  @@index([timestamp])
  @@map("execution_logs")
}

// ============================================================================
// INCIDENTS & NOTIFICATIONS
// ============================================================================

model Incident {
  id             String    @id @default(uuid())
  organizationId String
  title          String
  description    String?
  severity       String // critical, high, medium, low, info
  status         String    @default("detected") // detected, acknowledged, investigating, resolved
  source         String // automation, integration, manual, system
  sourceId       String?
  assignedTo     String?
  acknowledgedAt DateTime?
  acknowledgedBy String?
  resolvedAt     DateTime?
  resolvedBy     String?
  resolution     String?
  metadata       Json      @default("{}")
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  // Relations
  organization  Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  notifications Notification[]

  @@index([organizationId])
  @@index([severity])
  @@index([status])
  @@index([createdAt])
  @@map("incidents")
}

model NotificationChannel {
  id             String   @id @default(uuid())
  organizationId String
  name           String
  type           String // email, slack, webhook
  config         Json     @default("{}")
  enabled        Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // Relations
  organization  Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  notifications Notification[]

  @@index([organizationId])
  @@index([type])
  @@map("notification_channels")
}

model Notification {
  id          String    @id @default(uuid())
  incidentId  String
  channelId   String
  status      String    @default("pending") // pending, sent, delivered, failed
  attempts    Int       @default(0)
  sentAt      DateTime?
  deliveredAt DateTime?
  failedAt    DateTime?
  error       String?
  metadata    Json      @default("{}")
  createdAt   DateTime  @default(now())

  // Relations
  incident Incident            @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  channel  NotificationChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@index([incidentId])
  @@index([channelId])
  @@index([status])
  @@index([createdAt])
  @@map("notifications")
}

// ============================================================================
// BACKUPS & RECOVERY
// ============================================================================

model BackupPolicy {
  id              String   @id @default(uuid())
  organizationId  String
  name            String
  description     String?
  schedule        String // Cron expression
  retentionDays   Int      @default(30)
  targetType      String // database, files, configuration
  targetConfig    Json     @default("{}")
  storageType     String // local, s3, azure, gcs
  storageConfig   Json     @default("{}")
  encryption      Boolean  @default(true)
  verification    Boolean  @default(true)
  enabled         Boolean  @default(true)
  lastBackupAt    DateTime?
  lastVerifiedAt  DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Relations
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  backups      Backup[]

  @@index([organizationId])
  @@index([enabled])
  @@map("backup_policies")
}

model Backup {
  id               String    @id @default(uuid())
  policyId         String
  name             String
  size             BigInt // bytes
  checksum         String
  storageLocation  String
  status           String    @default("pending") // pending, inProgress, completed, failed
  verified         Boolean   @default(false)
  verifiedAt       DateTime?
  metadata         Json      @default("{}")
  startedAt        DateTime?
  completedAt      DateTime?
  failedAt         DateTime?
  error            String?
  expiresAt        DateTime?
  createdAt        DateTime  @default(now())

  // Relations
  policy   BackupPolicy       @relation(fields: [policyId], references: [id], onDelete: Cascade)
  restores RestoreOperation[]

  @@index([policyId])
  @@index([status])
  @@index([createdAt])
  @@index([expiresAt])
  @@map("backups")
}

model RestoreOperation {
  id               String    @id @default(uuid())
  backupId         String
  targetEnvironment String
  status           String    @default("pending") // pending, authorized, inProgress, completed, failed, cancelled
  authorizedBy     String?
  authorizedAt     DateTime?
  startedAt        DateTime?
  completedAt      DateTime?
  failedAt         DateTime?
  error            String?
  validationResult Json?
  metadata         Json      @default("{}")
  createdBy        String
  createdAt        DateTime  @default(now())

  // Relations
  backup Backup @relation(fields: [backupId], references: [id], onDelete: Cascade)

  @@index([backupId])
  @@index([status])
  @@index([createdAt])
  @@map("restore_operations")
}

// ============================================================================
// SECURITY
// ============================================================================

model SecurityFinding {
  id             String    @id @default(uuid())
  organizationId String
  title          String
  description    String
  severity       String // critical, high, medium, low, info
  confidence     String // high, medium, low
  category       String // authentication, authorization, credentials, network, data, dependencies
  affectedResource String?
  evidence       Json      @default("{}")
  impact         String?
  remediation    String?
  status         String    @default("open") // open, inProgress, resolved, accepted, falsePositive
  assignedTo     String?
  dueDate        DateTime?
  resolvedAt     DateTime?
  resolvedBy     String?
  detectedAt     DateTime  @default(now())
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  // Relations
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([severity])
  @@index([status])
  @@index([category])
  @@index([detectedAt])
  @@map("security_findings")
}

// ============================================================================
// DOCUMENTATION
// ============================================================================

model Document {
  id             String    @id @default(uuid())
  organizationId String
  title          String
  slug           String
  content        String
  type           String // runbook, architecture, procedure, policy, handover
  status         String    @default("draft") // draft, review, published
  version        Int       @default(1)
  ownerId        String?
  reviewedBy     String?
  reviewedAt     DateTime?
  publishedAt    DateTime?
  metadata       Json      @default("{}")
  createdBy      String
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  // Relations
  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  versions     DocumentVersion[]

  @@unique([organizationId, slug])
  @@index([organizationId])
  @@index([type])
  @@index([status])
  @@map("documents")
}

model DocumentVersion {
  id         String   @id @default(uuid())
  documentId String
  version    Int
  content    String
  changeLog  String?
  createdBy  String
  createdAt  DateTime @default(now())

  // Relations
  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([documentId, version])
  @@index([documentId])
  @@map("document_versions")
}

// ============================================================================
// PERFORMANCE & IMPROVEMENT
// ============================================================================

model PerformanceReview {
  id             String   @id @default(uuid())
  organizationId String
  title          String
  description    String?
  startDate      DateTime
  endDate        DateTime
  metrics        Json     @default("{}")
  findings       Json     @default("[]")
  status         String   @default("inProgress") // inProgress, completed, approved
  createdBy      String
  approvedBy     String?
  approvedAt     DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // Relations
  organization    Organization               @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  recommendations ImprovementRecommendation[]

  @@index([organizationId])
  @@index([startDate])
  @@index([endDate])
  @@map("performance_reviews")
}

model ImprovementRecommendation {
  id          String    @id @default(uuid())
  reviewId    String
  title       String
  description String
  priority    String // critical, high, medium, low
  category    String // performance, reliability, security, cost
  impact      String?
  effort      String? // low, medium, high
  status      String    @default("pending") // pending, accepted, inProgress, completed, rejected
  assignedTo  String?
  dueDate     DateTime?
  completedAt DateTime?
  outcome     String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // Relations
  review PerformanceReview @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  @@index([reviewId])
  @@index([status])
  @@index([priority])
  @@map("improvement_recommendations")
}

// ============================================================================
// AUDIT & COMPLIANCE
// ============================================================================

model AuditLog {
  id             String   @id @default(uuid())
  organizationId String
  userId         String?
  action         String
  resource       String
  resourceId     String?
  changes        Json?
  metadata       Json     @default("{}")
  ipAddress      String?
  userAgent      String?
  result         String // success, failure, denied
  timestamp      DateTime @default(now())

  // Relations
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User?        @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([userId])
  @@index([action])
  @@index([resource])
  @@index([timestamp])
  @@map("audit_logs")
}
