# Application
NODE_ENV=development
APP_NAME=Integration Security Platform
APP_URL=http://localhost:3000

# Backend API
API_PORT=3001
API_HOST=localhost
API_VERSION=v1

# Worker
WORKER_PORT=3002
WORKER_CONCURRENCY=5

# Database (PostgreSQL)
DATABASE_URL=postgresql://platform_user:platform_password@localhost:5432/platform_db
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10

# Redis
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=
REDIS_DB=0

# Authentication & Security
JWT_SECRET=CHANGE_THIS_TO_RANDOM_64_CHAR_STRING_IN_PRODUCTION
JWT_EXPIRES_IN=7d
SESSION_SECRET=CHANGE_THIS_TO_RANDOM_64_CHAR_STRING_IN_PRODUCTION
BCRYPT_ROUNDS=12

# Encryption (for integration credentials)
ENCRYPTION_KEY=CHANGE_THIS_TO_32_BYTE_HEX_STRING_IN_PRODUCTION

# Email (SMTP)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=noreply@example.com
SMTP_PASSWORD=smtp_password_here
SMTP_FROM=Platform <noreply@example.com>

# Integrations - GitHub
GITHUB_APP_ID=
GITHUB_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=

# Integrations - Slack
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_SIGNING_SECRET=

# Integrations - AWS (for backups)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_S3_BACKUP_BUCKET=

# Monitoring & Observability
LOG_LEVEL=info
ENABLE_REQUEST_LOGGING=true
ENABLE_METRICS=true

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Backup
BACKUP_RETENTION_DAYS=30
BACKUP_VERIFICATION_ENABLED=true

# Security
CORS_ORIGIN=http://localhost:3000
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax

# Feature Flags
ENABLE_MFA=false
ENABLE_SSO=false
